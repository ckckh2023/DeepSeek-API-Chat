{
  "name": "deepseek-api-chat",
  "version": "1.3.1",
  "description": "基于 DeepSeek API 的静态聊天应用。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "rspack build -c rspack.config.ts",
    "tauri": "tauri",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "type": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src rspack.config.ts",
    "check": "tsc -p tsconfig.json && vitest run && oxlint src rspack.config.ts",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@tauri-apps/cli": "^2.12.4",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/node": "~20.9.2",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.1"
  }
}
